# Copy to .env and set real values. .env is git-ignored; .env.example is tracked.
# Only override what you must. These are localhost defaults; change before the
# server is reachable beyond your machine.

# SonarQube container image (pinned, immutable).
SONARQUBE_IMAGE=sonarqube:26.8.0.126808-community

# PostgreSQL image for SonarQube's database.
POSTGRES_IMAGE=postgres:17

# Web port (default 9000).
SONAR_PORT=9000

# Local SonarQube + shared-Postgres credentials.
# Change these before exposing the server outside localhost.
POSTGRES_USER=sonar
POSTGRES_PASSWORD=sonar
