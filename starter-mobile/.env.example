# Build-time environment variables (set in EAS or local shell before `expo start`)

# development | production
APP_ENV=development

# Backend API URLs (never hardcode in source)
# This local default works in a web browser and the iOS Simulator.
# Android Emulator: use http://10.0.2.2:8080
# Physical device: use the Mac's reachable LAN IP or an HTTPS DEV/tunnel URL.
API_BASE_URL_DEV=http://localhost:8080
API_BASE_URL_PROD=https://starter-api-prod-XXXX.europe-west2.run.app

# Firebase web config (public client config — see run/run-local.md)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=starter-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=starter-dev

# Optional: set after `eas init`
EAS_PROJECT_ID=
