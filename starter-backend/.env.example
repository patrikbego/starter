# Local development environment variables (copy to .env and fill in values)
# Never commit .env to git

# Local profile (mocks - optional emulators)
GOOGLE_CLOUD_PROJECT=starter-local
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Dev-local profile (real DEV GCP from IDE)
# GOOGLE_APPLICATION_CREDENTIALS=$HOME/.gcp/starter-dev-sa.json
# GCP_PROJECT_ID=starter-dev
# OPENAI_API_KEY=sk-or-v1-...

# Cloud profiles (set in Cloud Run / Secret Manager)
# OPENAI_API_KEY=
# ACTUATOR_PASSWORD=
# STARTER_CORS_ALLOWED_ORIGINS=*
